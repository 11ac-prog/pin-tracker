# Postgres connection string. Provisioned through Vercel: Project -> Storage ->
# Create Database -> Postgres (Neon). `vercel env pull` writes this for you.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Vercel Blob (for uploaded photos). Project -> Storage -> Create Database -> Blob.
# `vercel env pull` writes this for you too; only needed manually if you're not
# using the Vercel CLI locally.
BLOB_READ_WRITE_TOKEN=""

# Basic auth gate for the deployed site. Leave both unset to disable (e.g. local dev).
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""
