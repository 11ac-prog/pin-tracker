# Postgres connection string (from Neon: dashboard -> your project -> Connect -> "Pooled connection")
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Cloudflare R2 (for uploaded photos). Create a bucket + API token in the Cloudflare dashboard.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="pin-tracker-uploads"
# The bucket's public base URL (R2.dev public access URL, or a custom domain you attach to the bucket)
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"

# Basic auth gate for the deployed site. Leave both unset to disable (e.g. local dev).
BASIC_AUTH_USER=""
BASIC_AUTH_PASSWORD=""
