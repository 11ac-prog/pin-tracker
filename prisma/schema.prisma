// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AcquisitionMethod {
  BOUGHT
  TRADED
  GIFTED
  OTHER
}

enum TradeDirection {
  GIVEN
  RECEIVED
}

enum PinStatus {
  OWNED
  SOLD
}

model Pin {
  id                String            @id @default(cuid())
  name              String
  series            String?
  imageUrl          String?
  // Date/method of the first purchase, kept here for card/detail display so
  // most read paths don't need to touch Purchase at all.
  acquisitionDate   DateTime?
  acquisitionMethod AcquisitionMethod @default(BOUGHT)
  // Cached aggregates, kept in sync by the purchase helpers whenever a
  // Purchase is added/edited/deleted: quantity is total currently owned
  // (purchases add to it, sells/trades subtract from it directly, same as
  // before); pricePaid is the quantity-weighted average cost across every
  // purchase ever recorded for this pin, regardless of how much has since
  // been sold — that average is what sell/trade cost-basis math uses.
  quantity          Int               @default(1)
  pricePaid         Float?
  currentValue      Float?
  notes             String?
  status            PinStatus         @default(OWNED)
  soldPrice         Float?
  soldDate          DateTime?
  shippingCost      Float?
  purchases         Purchase[]
  tradeItems        TradeItem[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// One buying event for a Pin — lets the same pin design be "topped up" at a
// different price later (the + button) instead of becoming a separate card,
// while still keeping each purchase's own price/date on the pin's detail page.
model Purchase {
  id                String            @id @default(cuid())
  pin               Pin               @relation(fields: [pinId], references: [id], onDelete: Cascade)
  pinId             String
  quantity          Int               @default(1)
  pricePaid         Float?
  acquisitionDate   DateTime?
  acquisitionMethod AcquisitionMethod @default(BOUGHT)
  notes             String?
  createdAt         DateTime          @default(now())
  // Set when this purchase came from a trade's received item, so deleting
  // that trade can find and undo exactly this purchase (and only this one,
  // even if the pin has other purchases from elsewhere).
  tradeItem         TradeItem?        @relation(fields: [tradeItemId], references: [id], onDelete: SetNull)
  tradeItemId       String?           @unique
}

model WishlistItem {
  id             String   @id @default(cuid())
  name           String
  series         String?
  imageUrl       String?
  estimatedValue Float?
  priority       Int      @default(2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Trade {
  id           String      @id @default(cuid())
  date         DateTime    @default(now())
  partnerName  String?
  notes        String?
  shippingCost Float?
  items        TradeItem[]
  createdAt    DateTime    @default(now())
}

model TradeItem {
  id             String         @id @default(cuid())
  trade          Trade          @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tradeId        String
  direction      TradeDirection
  description    String
  imageUrl       String?
  quantity       Int            @default(1)
  estimatedValue Float?
  pin            Pin?           @relation(fields: [pinId], references: [id])
  pinId          String?
  purchase       Purchase?
  // For a GIVEN item: whether it was linked to a pin at all (as opposed to
  // "something not in your collection"), plus a snapshot of that pin's own
  // fields at the time. If the pin was fully given away it gets hard-deleted
  // right after (its FK here goes to null automatically) — this snapshot is
  // what lets deleting the trade later recreate it faithfully.
  wasLinkedToPin         Boolean            @default(false)
  givenSeries            String?
  givenAcquisitionDate   DateTime?
  givenAcquisitionMethod AcquisitionMethod?
  givenNotes             String?
}
